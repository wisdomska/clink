# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_SITE_URL=
# 32+ random bytes (openssl rand -hex 32). Signs the After Dark session cookie.
APP_SECRET=
# 24+ random bytes. pg_cron sends it as a bearer token to /api/jobs/*.
CRON_SECRET=
# Comma-separated emails that scripts/seed-admin.ts promotes to admin.
ADMIN_EMAILS=

# Supabase (one project per environment)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage: "supabase" (default) or "r2"
STORAGE_DRIVER=supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=clink-media
R2_BUCKET_SENSITIVE=clink-sensitive

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Errors (Sentry Developer plan). Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Product analytics (PostHog free, cookieless). Leave empty to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Age verification: "self" (default) or "provider" (stub until a provider is chosen)
AGE_VERIFICATION_PROVIDER=self

# Weekly admin health email (Brevo SMTP relay). Without these, nothing is sent.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER=
# Local runs and tests: the mail catcher that comes with Supabase.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=54325
