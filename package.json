{
  "name": "clink",
  "version": "0.1.0",
  "private": true,
  "description": "Clink: things to do together, from apart. An 18+ installable web app for long-distance couples.",
  "author": "wisdomska(senya)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "db:types": "supabase gen types typescript --schema public 2>/dev/null > src/types/database.ts",
    "db:reset": "supabase db reset",
    "icons": "tsx scripts/make-icons.tsx",
    "seed:admin": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@hookform/resolvers": "^7.0.6",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "city-timezones": "^1.3.4",
    "fflate": "^0.8.3",
    "geist": "^1.9.2",
    "hash-wasm": "^4.13.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "perfect-freehand": "^1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "word-list": "^4.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@serwist/next": "^9.5.13",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.13",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json,md,mjs,mts}": [
      "prettier --write"
    ]
  }
}
